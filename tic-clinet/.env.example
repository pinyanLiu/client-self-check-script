# n8n Webhook URLs (必填)
N8N_LOG_WEBHOOK_URL=https://your-n8n.example.com/webhook/nvme-log
N8N_HEARTBEAT_WEBHOOK_URL=https://your-n8n.example.com/webhook/nvme-heartbeat
N8N_ALERT_WEBHOOK_URL=https://your-n8n.example.com/webhook/nvme-alert

# HTTP API 設定
API_HOST=0.0.0.0
API_PORT=8080

# 監控間隔 (秒)
HEARTBEAT_INTERVAL_SEC=300
DISK_CHECK_INTERVAL_SEC=10
PROCESS_POLL_INTERVAL_SEC=1.0

# 指定監控的 NVMe 控制器 (逗號分隔，留空=全部)
# NVME_WATCH_LIST=nvme0,nvme1

# Crash 判定：Log 中必須包含的結束標記 (留空=僅依 return code)
# COMPLETION_MARKER=TEST_COMPLETED

# 指令逾時 (秒，0=不限制)
COMMAND_TIMEOUT_SEC=0

# HTTP 請求逾時
HTTP_TIMEOUT_SEC=30

# 是否允許 POST /reset 從 abnormal 復原
ALLOW_MANUAL_RESET=true

# Mac 本機開發請改用 .env.mac.example (DEV_MODE=true)
# DEV_MODE=false
