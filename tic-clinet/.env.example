# n8n Webhook URLs (必填)
N8N_STATUS_WEBHOOK_URL=http://192.168.14.5:5678/webhook/update_client_status

N8N_LOG_WEBHOOK_URL=http://192.168.14.5:5678/webhook/upload-file
N8N_HEARTBEAT_WEBHOOK_URL=https://your-n8n.example.com/webhook/nvme-heartbeat
N8N_ALERT_WEBHOOK_URL=https://your-n8n.example.com/webhook/nvme-alert

# 可選：專用狀態 Webhook（寫入 n8n Data Table）；未設定則與 Heartbeat 相同
# N8N_STATUS_WEBHOOK_URL=https://your-n8n.example.com/webhook/nvme-status

# 每台測試機唯一 ID（Data Table Upsert 主鍵，建議手動設定）
MACHINE_IP=192.168.0.2
MACHINE_NAME=myClient

# HTTP API 設定
API_HOST=0.0.0.0
API_PORT=8080

# 監控間隔 (秒)
HEARTBEAT_INTERVAL_SEC=300
DISK_CHECK_INTERVAL_SEC=10
PROCESS_POLL_INTERVAL_SEC=1.0

# 指定監控的 NVMe 控制器 (逗號分隔，留空=全部)
# NVME_WATCH_LIST=nvme0,nvme1

# Crash 判定：Log 中必須包含的結束標記 (留空=僅依 return code)
COMPLETION_MARKER="----> Exit Test....Pass"

# PPS2 工作目錄（指令在最新 PPS2* 資料夾執行，log 於 app/Debug/log）
NVME_WORK_BASE=/home/nvme
PPS2_FOLDER_PREFIX=PPS2-PATTERN
DEBUG_LOG_REL_PATH=log
REQUIRE_DEBUG_LOGS=true
DEBUG_LOG_MAX_BYTES=524288

# 指令逾時 (秒，0=不限制)
COMMAND_TIMEOUT_SEC=0

# HTTP 請求逾時
HTTP_TIMEOUT_SEC=30

# 是否允許 POST /reset 從 abnormal 復原
ALLOW_MANUAL_RESET=true

# Mac 本機開發請改用 .env.mac.example (DEV_MODE=true)
DEV_MODE=false
