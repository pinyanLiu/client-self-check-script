# ===== Mac 本機 + n8n 狀態（混合測試）=====

DEV_MODE=true
MOCK_NVME_DEVICES=nvme0

# 狀態 → 你的 n8n Cloud（寫入 Data Table 用這條）
# 正式 URL（Workflow 須 Active）；測試用 webhook-test 僅能手動 Listen 一次
N8N_STATUS_WEBHOOK_URL=https://pinyen.app.n8n.cloud/webhook/nvme-status

# Log / Heartbeat / Alert 可先走本機 Mock（需另開 mock_webhook_server.py）
# 若已建立對應 n8n Webhook，可改成 https://pinyen.app.n8n.cloud/webhook/...
N8N_LOG_WEBHOOK_URL=http://127.0.0.1:9001/log
N8N_HEARTBEAT_WEBHOOK_URL=http://127.0.0.1:9001/heartbeat
N8N_ALERT_WEBHOOK_URL=http://127.0.0.1:9001/alert

MACHINE_ID=mac-dev-01
MACHINE_NAME=Mac 本機開發
MACHINE_OWNER=pinyen
MACHINE_LOCATION=local

API_HOST=127.0.0.1
API_PORT=8080

# 測試時可縮短，方便看 n8n 是否收到 heartbeat
HEARTBEAT_INTERVAL_SEC=30
DISK_CHECK_INTERVAL_SEC=5
PROCESS_POLL_INTERVAL_SEC=1.0

HTTP_TIMEOUT_SEC=30
COMMAND_TIMEOUT_SEC=0
ALLOW_MANUAL_RESET=true
