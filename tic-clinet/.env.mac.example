# ===== Mac 本機開發用設定 =====
# 複製: cp .env.mac.example .env

# Mac 本機模擬 PPS2 目錄結構（請先建立該路徑與 PPS2_test/app/Debug/log）
# NVME_WORK_BASE=/tmp/nvme-mock

# 開啟 Mock 模式 (不讀 /sys/class/nvme/)
DEV_MODE=true
MOCK_NVME_DEVICES=nvme0

# 指向本機 Mock Webhook (先執行 scripts/mock_webhook_server.py)
N8N_LOG_WEBHOOK_URL=http://127.0.0.1:9001/log
N8N_HEARTBEAT_WEBHOOK_URL=http://127.0.0.1:9001/heartbeat
N8N_ALERT_WEBHOOK_URL=http://127.0.0.1:9001/alert
N8N_STATUS_WEBHOOK_URL=http://127.0.0.1:9001/status

MACHINE_ID=mac-dev-01
MACHINE_NAME=Mac 本機開發
MACHINE_OWNER=dev

API_HOST=127.0.0.1
API_PORT=8080

# Mac 測試時縮短間隔，方便觀察
HEARTBEAT_INTERVAL_SEC=30
DISK_CHECK_INTERVAL_SEC=5

# 測試 Crash 判定時可啟用
# COMPLETION_MARKER=TEST_COMPLETED

ALLOW_MANUAL_RESET=true
